# Port 0 selects a free local port automatically.
VELIN_ADDR=127.0.0.1:0
VELIN_ADMIN_USER=admin
VELIN_ADMIN_PASSWORD=replace-with-a-strong-password
VELIN_HOST_PORT_ADDR=127.0.0.1
# RDP requires a separately running guacd service. VNC does not use guacd.
VELIN_GUACD_ADDR=127.0.0.1:4822
VELIN_DESKTOP_PROXY_ADDR=127.0.0.1
VELIN_RDP_DRIVE_DIR=/tmp/velin-rdp-drives
VELIN_AI_BASE_URL=
VELIN_AI_MODEL=
VELIN_AI_API_KEY=
VELIN_FFMPEG_BINARY=ffmpeg
